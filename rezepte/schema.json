{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kochbuch – Rezeptdatei (rezepte.json)",
  "type": "object",
  "required": [
    "format",
    "version",
    "rezepte"
  ],
  "properties": {
    "format": {
      "const": "kochbuch-rezepte"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "grundlagen": {
      "$ref": "#/$defs/glossar",
      "description": "Allgemeine Küchentipps, in allen Rezepten mit [[id|Text]] verwendbar"
    },
    "rezepte": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/rezept"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "menge": {
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0
    },
    "glossar": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "begriff",
          "text"
        ],
        "properties": {
          "begriff": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "rezept": {
      "type": "object",
      "required": [
        "id",
        "titel",
        "quelle",
        "portionen_basis",
        "zeit_total_min",
        "zutaten",
        "schritte"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "titel": {
          "type": "string",
          "minLength": 1
        },
        "untertitel": {
          "type": [
            "string",
            "null"
          ]
        },
        "quelle": {
          "type": "object",
          "required": [
            "name",
            "url"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "url": {
              "type": "string",
              "description": "https://… oder leer, falls keine Quelle bekannt"
            }
          },
          "additionalProperties": false
        },
        "portionen_basis": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "Für wie viele Portionen die Mengen gelten; null = nicht angegeben (App rechnet dann mit Faktor)"
        },
        "zeit_total_min": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "kategorien": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "zutaten": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "menge",
              "einheit",
              "name"
            ],
            "properties": {
              "menge": {
                "$ref": "#/$defs/menge"
              },
              "einheit": {
                "type": "string",
                "description": "g, kg, ml, dl, l, EL, TL, Bund, Dose, Stück … oder leer"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "notiz": {
                "type": "string"
              },
              "gruppe": {
                "type": "string",
                "description": "z.B. «Sauce»; Zutaten mit gleicher Gruppe werden zusammen angezeigt"
              },
              "je": {
                "type": "boolean",
                "description": "true = «je 0.5 Bund …»"
              },
              "plus": {
                "type": "object",
                "required": [
                  "menge",
                  "einheit"
                ],
                "properties": {
                  "menge": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "einheit": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              },
              "alternative": {
                "type": "object",
                "required": [
                  "text",
                  "menge",
                  "einheit"
                ],
                "properties": {
                  "text": {
                    "type": "string"
                  },
                  "menge": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "einheit": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "schritte": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "description": "Begriffe als [[glossar-id|angezeigter Text]] markieren"
              },
              "timer": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "label",
                    "min"
                  ],
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "min": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "glossar": {
          "$ref": "#/$defs/glossar"
        },
        "naehrwerte": {
          "type": "object",
          "properties": {
            "kcal": {
              "type": "number"
            },
            "protein_g": {
              "type": "number"
            },
            "fett_g": {
              "type": "number"
            },
            "kohlenhydrate_g": {
              "type": "number"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}